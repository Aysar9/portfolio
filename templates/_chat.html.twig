{# AI assistant widget — grounded in Aysar's portfolio content via Gemini #}
<div data-controller="chat"
     data-chat-endpoint-value="{{ path('app_chat') }}"
     data-chat-error-value="{{ 'chat.error'|trans }}">

    {# Launcher button #}
    <button type="button"
            data-chat-target="launcher"
            data-action="chat#toggle"
            aria-expanded="false"
            aria-controls="chat-panel"
            class="fixed bottom-5 right-5 z-40 flex items-center gap-2 rounded-full bg-primary px-5 py-3 text-on-primary shadow-lg hover:bg-primary-700 transition-colors">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="1.75" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M8 10h8M8 14h5M21 12a8 8 0 0 1-11.6 7.1L3 21l1.9-6.4A8 8 0 1 1 21 12Z"/>
        </svg>
        <span class="font-medium text-sm">{{ 'chat.button'|trans }}</span>
    </button>

    {# Panel #}
    <section id="chat-panel"
             data-chat-target="panel"
             hidden
             class="fixed bottom-5 right-5 z-40 flex h-[32rem] max-h-[80vh] w-[calc(100vw-2.5rem)] max-w-sm flex-col overflow-hidden rounded-md border border-line bg-surface shadow-2xl">

        <header class="flex items-center justify-between border-b border-line bg-canvas px-4 py-3">
            <span class="font-display text-base font-semibold tracking-tight text-ink">{{ 'chat.title'|trans }}</span>
            <button type="button"
                    data-action="chat#toggle"
                    aria-label="{{ 'chat.close'|trans }}"
                    class="rounded-md p-1 text-muted hover:text-primary transition-colors">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="1.75" viewBox="0 0 24 24" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M6 6l12 12M18 6L6 18"/>
                </svg>
            </button>
        </header>

        <div data-chat-target="messages" class="flex-1 space-y-3 overflow-y-auto px-4 py-4 text-sm" aria-live="polite">
            <div class="max-w-[85%] rounded-md bg-canvas px-3 py-2 text-ink/80">{{ 'chat.intro'|trans }}</div>
        </div>

        <form data-action="chat#send" class="flex items-center gap-2 border-t border-line p-3">
            <input data-chat-target="input"
                   type="text"
                   autocomplete="off"
                   placeholder="{{ 'chat.placeholder'|trans }}"
                   class="flex-1 rounded-md border border-line bg-surface px-3 py-2 text-sm text-ink focus:border-primary focus:outline-none"
                   maxlength="1000">
            <button type="submit"
                    data-chat-target="submit"
                    class="rounded-md bg-primary px-4 py-2 text-sm font-medium text-on-primary hover:bg-primary-700 transition-colors disabled:opacity-50">
                {{ 'chat.send'|trans }}
            </button>
        </form>
    </section>
</div>
