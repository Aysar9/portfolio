{% extends 'base.html.twig' %}

{% block title %}{{ 'error404.title'|trans }}{% endblock %}

{% block body %}
<section class="notebook-page max-w-4xl mx-auto px-6 pt-32 pb-24 text-center">
    <p data-notebook-motion-target="intro" class="font-display text-7xl font-semibold text-primary mb-4">404</p>
    <h1 class="font-display text-3xl font-semibold tracking-tight mb-4" aria-label="{{ 'error404.heading'|trans }}">
        <span aria-hidden="true" data-notebook-motion-target="writing">{{ 'error404.heading'|trans }}</span>
    </h1>
    <p data-notebook-motion-target="intro" class="text-lg text-muted mb-8 max-w-md mx-auto leading-relaxed">
        {{ 'error404.text'|trans }}
    </p>
    <a data-notebook-motion-target="section" href="{{ path('app_home', {'_locale': app.request.locale}) }}"
       class="notebook-button inline-block px-6 py-3 bg-primary text-on-primary rounded-md font-medium hover:bg-primary-700 transition-colors">
        {{ 'error404.home'|trans }}
    </a>
</section>
{% endblock %}
