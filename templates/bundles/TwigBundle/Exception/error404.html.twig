{% extends 'base.html.twig' %}

{% block title %}{{ 'error404.title'|trans }}{% endblock %}

{% block body %}
<section class="max-w-4xl mx-auto px-6 pt-32 pb-24 text-center">
    <p class="font-display text-7xl font-semibold text-primary mb-4">404</p>
    <h1 class="font-display text-3xl font-semibold tracking-tight mb-4">
        {{ 'error404.heading'|trans }}
    </h1>
    <p class="text-lg text-muted mb-8 max-w-md mx-auto leading-relaxed">
        {{ 'error404.text'|trans }}
    </p>
    <a href="{{ path('app_home', {'_locale': app.request.locale}) }}"
       class="inline-block px-6 py-3 bg-primary text-white rounded-md font-medium hover:bg-primary-700 transition-colors">
        {{ 'error404.home'|trans }}
    </a>
</section>
{% endblock %}
