{% extends 'base.html.twig' %}

{% block title %}{{ 'error404.title'|trans }}{% endblock %}

{% block body %}
<section class="max-w-4xl mx-auto px-6 pt-32 pb-24 text-center">
    <p class="text-7xl font-bold text-[#3730A3] mb-4" style="font-family: 'Sora', sans-serif;">404</p>
    <h1 class="text-3xl font-bold mb-4" style="font-family: 'Sora', sans-serif;">
        {{ 'error404.heading'|trans }}
    </h1>
    <p class="text-lg text-[#6B7280] mb-8 max-w-md mx-auto">
        {{ 'error404.text'|trans }}
    </p>
    <a href="{{ path('app_home', {'_locale': app.request.locale}) }}"
       class="inline-block px-6 py-3 bg-[#3730A3] text-white rounded-lg font-medium hover:bg-[#2d2882] transition-colors">
        {{ 'error404.home'|trans }}
    </a>
</section>
{% endblock %}