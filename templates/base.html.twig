<!DOCTYPE html>
<html lang="{{ app.request.locale }}">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    {# Default to light; apply an explicitly saved dark theme before paint #}
    <script>
        (function () {
            try {
                var t = localStorage.getItem('theme');
                if (t === 'dark') {
                    document.documentElement.classList.add('dark');
                }
            } catch (e) {}
        })();
    </script>

<title>{% block title %}Aysar Alatrash{% endblock %}</title>

    {# SEO #}
    <meta name="description" content="{% block meta_description %}{{ 'meta.description'|trans }}{% endblock %}">
    <meta name="author" content="Aysar Alatrash">

    <link rel="icon" href="{{ asset('favicon.svg') }}" type="image/svg+xml">

    {# Open Graph (LinkedIn, Facebook, WhatsApp) #}
    <meta property="og:type" content="website">
    <meta property="og:title" content="{{ 'meta.og_title'|trans }}">
    <meta property="og:description" content="{{ 'meta.og_description'|trans }}">
    <meta property="og:url" content="https://aysar-alatrash.de">
    <meta property="og:locale" content="{{ app.request.locale == 'en' ? 'en_US' : 'de_DE' }}">

    {# Twitter / X #}
    <meta name="twitter:card" content="summary">
    <meta name="twitter:title" content="{{ 'meta.og_title'|trans }}">
    <meta name="twitter:description" content="{{ 'meta.og_description'|trans }}">

    {# Fonts are self-hosted via @font-face in app.css — no external font requests #}
    {# Privacy-friendly analytics (self-hosted Umami) — only in production, no cookies #}
    {% if app.environment == 'prod' %}
        <script defer src="https://analytics.aysar-alatrash.de/script.js" data-website-id="943014cf-de1a-446b-b474-cbf868337159"></script>
    {% endif %}

    {% block stylesheets %}
        {{ importmap() }}
    {% endblock %}
</head>
<body class="text-ink antialiased font-sans">
    <a href="#main-content" class="skip-link">{{ 'layout.skip_content'|trans }}</a>
    <div class="notebook-shell">
    <div class="notebook-holes" aria-hidden="true"></div>

    <header class="notebook-header" data-controller="navbar">
    <nav class="notebook-nav flex flex-wrap items-center justify-between gap-y-4">
        <a href="{{ path('app_home') }}" class="notebook-signature whitespace-nowrap">
            Aysar Alatrash
        </a>

        {# Hamburger — mobile only #}
        <button type="button"
                class="md:hidden -mr-2 p-2 text-ink rounded-md hover:text-primary transition-colors"
                data-navbar-target="button"
                data-action="navbar#toggle"
                aria-expanded="false"
                aria-controls="primary-nav"
                aria-label="{{ 'nav.menu'|trans }}">
            <svg data-navbar-target="openIcon" class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="1.75" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d="M4 7h16M4 12h16M4 17h16"/>
            </svg>
            <svg data-navbar-target="closeIcon" class="hidden w-6 h-6" fill="none" stroke="currentColor" stroke-width="1.75" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d="M6 6l12 12M18 6L6 18"/>
            </svg>
        </button>

        {# Links — stacked on mobile, inline on desktop #}
        <div id="primary-nav" data-navbar-target="menu" class="hidden w-full md:block md:w-auto">
            <div class="notebook-nav-links flex flex-col gap-4 md:flex-row md:items-center md:gap-6 text-muted">
                {% set current_route = app.request.attributes.get('_route')|default('') %}
                {% for route, label in {'app_home': 'nav.start', 'app_about': 'nav.about', 'app_projekte': 'nav.projekte', 'app_kontakt': 'nav.kontakt'} %}
                    {% set is_current = current_route == route %}
                    {% set in_projects = route == 'app_projekte' and current_route starts with 'app_projekt_' %}
                    <a href="{{ path(route) }}" data-action="navbar#close"
                       class="notebook-nav-item {{ is_current or in_projects ? 'is-active' : '' }}"
                       {% if is_current %}aria-current="page"{% elseif in_projects %}aria-current="location"{% endif %}>{{ label|trans }}</a>
                {% endfor %}

                {# Language toggle — fall back to home on routes without params (e.g. error pages) #}
                {% set lang_route = app.request.attributes.get('_route')|default('app_home') %}
                {% set lang_params = app.request.attributes.get('_route_params')|default({}) %}
                <span class="flex gap-1 pt-4 border-t border-line md:pt-0 md:border-t-0 md:border-l md:pl-4">
                    <a href="{{ path(lang_route, lang_params|merge({'_locale': 'de'})) }}"
                    class="{{ app.request.locale == 'de' ? 'text-primary font-semibold' : 'hover:text-primary' }} transition-colors">DE</a>
                    <span>/</span>
                    <a href="{{ path(lang_route, lang_params|merge({'_locale': 'en'})) }}"
                    class="{{ app.request.locale == 'en' ? 'text-primary font-semibold' : 'hover:text-primary' }} transition-colors">EN</a>
                </span>

                {# Theme toggle #}
                <button type="button"
                        data-controller="theme"
                        data-action="theme#toggle"
                        aria-label="{{ 'nav.theme'|trans }}"
                        class="-ml-1 rounded-md p-1 text-muted hover:text-primary transition-colors">
                    <svg data-theme-target="moon" class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="1.75" viewBox="0 0 24 24" aria-hidden="true">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8Z"/>
                    </svg>
                    <svg data-theme-target="sun" class="hidden w-5 h-5" fill="none" stroke="currentColor" stroke-width="1.75" viewBox="0 0 24 24" aria-hidden="true">
                        <circle cx="12" cy="12" r="4"/>
                        <path stroke-linecap="round" d="M12 2v2M12 20v2M4 12H2M22 12h-2M5 5l1.5 1.5M17.5 17.5 19 19M19 5l-1.5 1.5M6.5 17.5 5 19"/>
                    </svg>
                </button>
            </div>
        </div>
    </nav>
    </header>

    <main id="main-content" class="notebook-main" tabindex="-1" {% block main_attributes %}data-controller="notebook-motion" data-action="focusin->notebook-motion#revealFocusedSection turbo:before-cache@document->notebook-motion#finish"{% endblock %}>
        {% block body %}{% endblock %}
    </main>

    <footer class="notebook-footer">
        <div class="text-xs text-muted flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
            <span>© {{ "now"|date("Y") }} Aysar Alatrash</span>
            <div class="flex flex-wrap items-center gap-x-4 gap-y-2">
                <a href="{{ path('app_impressum') }}" class="hover:text-primary transition-colors">{{ 'footer.impressum'|trans }}</a>
                <a href="{{ path('app_datenschutz') }}" class="hover:text-primary transition-colors">{{ 'footer.datenschutz'|trans }}</a>
                <span>{{ 'layout.location'|trans }}</span>
            </div>
        </div>
    </footer>
    </div>

    {% include '_chat.html.twig' %}

</body>
</html>
