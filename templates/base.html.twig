<!DOCTYPE html>
<html lang="{{ app.request.locale }}">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>{% block title %}Aysar Alatrash{% endblock %}</title>

    {# SEO #}
    <meta name="description" content="{% block meta_description %}{{ 'meta.description'|trans }}{% endblock %}">
    <meta name="author" content="Aysar Alatrash">

    {# Open Graph (LinkedIn, Facebook, WhatsApp) #}
    <meta property="og:type" content="website">
    <meta property="og:title" content="{{ 'meta.og_title'|trans }}">
    <meta property="og:description" content="{{ 'meta.og_description'|trans }}">
    <meta property="og:url" content="https://aysar-alatrash.de">
    <meta property="og:locale" content="{{ app.request.locale == 'en' ? 'en_US' : 'de_DE' }}">

    {# Twitter / X #}
    <meta name="twitter:card" content="summary">
    <meta name="twitter:title" content="{{ 'meta.og_title'|trans }}">
    <meta name="twitter:description" content="{{ 'meta.og_description'|trans }}">

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;500;600;700&family=Inter:wght@400;500;600&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">
    {% block stylesheets %}
        {{ importmap() }}
    {% endblock %}
</head>
<body class="bg-canvas text-ink antialiased font-sans">

    <header class="border-b border-line">
    <nav class="max-w-4xl mx-auto px-6 py-5 flex items-center justify-between">
        <a href="{{ path('app_home') }}" class="font-display text-xl font-semibold tracking-tight text-ink">
            Aysar Alatrash
        </a>
        <div class="flex items-center gap-6 text-sm text-muted">
            <a href="{{ path('app_home') }}" class="hover:text-primary transition-colors">{{ 'nav.start'|trans }}</a>
            <a href="{{ path('app_about') }}" class="hover:text-primary transition-colors">{{ 'nav.about'|trans }}</a>
            <a href="{{ path('app_projekte') }}" class="hover:text-primary transition-colors">{{ 'nav.projekte'|trans }}</a>
            <a href="{{ path('app_kontakt') }}" class="hover:text-primary transition-colors">{{ 'nav.kontakt'|trans }}</a>

            {# Language toggle #}
            <span class="flex gap-1 border-l border-line pl-4">
                <a href="{{ path(app.request.attributes.get('_route'), app.request.attributes.get('_route_params')|merge({'_locale': 'de'})) }}"
                class="{{ app.request.locale == 'de' ? 'text-primary font-semibold' : 'hover:text-primary' }} transition-colors">DE</a>
                <span>/</span>
                <a href="{{ path(app.request.attributes.get('_route'), app.request.attributes.get('_route_params')|merge({'_locale': 'en'})) }}"
                class="{{ app.request.locale == 'en' ? 'text-primary font-semibold' : 'hover:text-primary' }} transition-colors">EN</a>
            </span>
        </div>
    </nav>
    </header>

    <main>
        {% block body %}{% endblock %}
    </main>

    <footer class="border-t border-line mt-24">
        <div class="max-w-4xl mx-auto px-6 py-8 text-sm text-muted flex justify-between">
            <span>© {{ "now"|date("Y") }} Aysar Alatrash</span>
            <span>{{ 'layout.location'|trans }}</span>
        </div>
    </footer>

</body>
</html>