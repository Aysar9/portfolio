{% extends 'base.html.twig' %}

{% block title %}{{ 'projekte.title'|trans }}{% endblock %}

{% block body %}
<section class="max-w-4xl mx-auto px-6 pt-20 pb-16">
    <p class="font-mono text-xs uppercase tracking-[0.2em] text-primary mb-5">{{ 'projekte.label'|trans }}</p>
    <h1 class="font-display text-4xl md:text-5xl font-semibold leading-[1.1] tracking-tight mb-12">
        {{ 'projekte.heading'|trans }}
    </h1>

    <a href="{{ path('app_projekt_intranet') }}"
       class="block p-8 bg-surface border border-line rounded-md hover:border-primary hover:shadow-[0_1px_24px_-12px_rgba(17,24,39,0.25)] transition-all group">
        <div class="flex items-center justify-between gap-4 mb-3">
            <h2 class="font-display text-2xl md:text-3xl font-semibold tracking-tight">
                {{ 'projekte.intranet_title'|trans }}
            </h2>
            <span aria-hidden="true" class="text-primary translate-x-0 group-hover:translate-x-1 transition-transform">&rarr;</span>
        </div>
        <p class="text-muted mb-5 leading-relaxed">
            {{ 'projekte.intranet_text'|trans }}
        </p>
        <div class="flex flex-wrap gap-2 font-mono text-xs">
            {% for tech in ['Symfony 7.4', 'PHP 8.2+', 'Doctrine DBAL', 'LDAP / AD', 'Messenger + Redis'] %}
                <span class="px-3 py-1 bg-canvas border border-line rounded-full text-ink/80">{{ tech }}</span>
            {% endfor %}
        </div>
    </a>
</section>
{% endblock %}
