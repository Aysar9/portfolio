{# Fictional stored readings, not a live connection to a printer. #}
<figure class="workflow-figure printers-preview {{ compact|default(false) ? 'preview-compact' : '' }}">
    <div class="workflow-window">
        <div class="workflow-window-bar"><span>{{ 'intranet_printers.label'|trans }}</span><strong>{{ 'workflow.sample_label'|trans }}</strong></div>
        <div class="printer-layout">
            <div class="printer-readings">
                <p class="preview-eyebrow">{{ 'intranet_printers.example_device'|trans }}</p>
                <div class="printer-counter"><strong>12 840</strong><span>{{ 'intranet_printers.counter'|trans }}</span></div>
                <div class="printer-toner-heading"><span>{{ 'intranet_printers.toner'|trans }}</span><strong>42 %</strong></div>
                <div class="printer-toner-track" aria-hidden="true"><span></span></div>
                <p class="printer-history-heading">{{ 'intranet_printers.stored_readings'|trans }}</p>
                <ol class="printer-history" aria-label="{{ 'intranet_printers.stored_readings'|trans }}">
                    {% for reading in [{day: 'day1', value: '12 720'}, {day: 'day2', value: '12 780'}, {day: 'day3', value: '12 840'}] %}
                        <li><span>{{ ('intranet_printers.' ~ reading.day)|trans }}</span><strong>{{ reading.value }}</strong></li>
                    {% endfor %}
                </ol>
                {% if not compact|default(false) %}<div class="printer-source"><span>SNMP</span><span aria-hidden="true">→</span><span>{{ 'intranet_printers.history'|trans }}</span></div>{% endif %}
            </div>
            {% if not compact|default(false) %}
                <div class="printer-maintenance">
                    <p class="preview-eyebrow">{{ 'intranet_printers.maintenance'|trans }}</p>
                    <p class="preview-title">{{ 'intranet_printers.maintenance_entry'|trans }}</p>
                    <p class="printer-maintenance-date">{{ 'intranet_printers.day2'|trans }}</p>
                    <p class="printer-maintenance-note">{{ 'intranet_printers.maintenance_note'|trans }}</p>
                </div>
            {% endif %}
        </div>
    </div>
    {% if not compact|default(false) %}<figcaption class="workflow-caption">{{ 'intranet_printers.caption'|trans }}</figcaption>{% endif %}
</figure>
