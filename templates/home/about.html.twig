{% extends 'base.html.twig' %}

{% block title %}{{ 'about.title'|trans }}{% endblock %}

{% block body %}
<section class="max-w-4xl mx-auto px-6 pt-20 pb-16">
    <p class="text-sm uppercase tracking-widest text-[#3730A3] mb-4">{{ 'about.label'|trans }}</p>
    <h1 class="text-4xl md:text-5xl font-bold leading-tight mb-8" style="font-family: 'Sora', sans-serif;">
        {{ 'about.heading'|trans }}
    </h1>

    <div class="space-y-6 text-lg text-[#374151] leading-relaxed max-w-2xl">
        <p>{{ 'about.p1'|trans }}</p>
        <p>{{ 'about.p2'|trans }}</p>
        <p>{{ 'about.p3'|trans }}</p>
    </div>
    <div class="mt-10">
        <a href="{{ asset('files/Lebenslauf-Aysar-Alatrash.pdf') }}" target="_blank" rel="noopener"
           class="inline-flex items-center gap-2 px-6 py-3 bg-[#3730A3] text-white rounded-lg font-medium hover:bg-[#2d2882] transition-colors">
            {{ 'about.cv_download'|trans }}
        </a>
    </div>
</section>
{% endblock %}