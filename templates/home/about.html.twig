{% extends 'base.html.twig' %}

{% block title %}{{ 'about.title'|trans }}{% endblock %}

{% block body %}
<section class="max-w-4xl mx-auto px-6 pt-20 pb-16">
    <p class="font-mono text-xs uppercase tracking-[0.2em] text-primary mb-5">{{ 'about.label'|trans }}</p>
    <h1 class="font-display text-4xl md:text-5xl font-semibold leading-[1.1] tracking-tight mb-8">
        {{ 'about.heading'|trans }}
    </h1>

    <div class="space-y-6 text-lg text-ink/80 leading-relaxed max-w-2xl">
        <p>{{ 'about.p1'|trans }}</p>
        <p>{{ 'about.p2'|trans }}</p>
        <p>{{ 'about.p3'|trans }}</p>
    </div>
    <div class="mt-10">
        <a href="{{ asset('files/Lebenslauf_Aysar_Alatrash.pdf') }}" target="_blank" rel="noopener"
           class="inline-flex items-center gap-2 px-6 py-3 bg-primary text-white rounded-md font-medium hover:bg-primary-700 transition-colors">
            {{ 'about.cv_download'|trans }}
        </a>
    </div>
</section>
{% endblock %}
