{% extends 'base.html.twig' %}

{% block title %}{{ 'home.title'|trans }}{% endblock %}

{% block body %}

{# ===== Hero ===== #}
<section class="max-w-4xl mx-auto px-6 pt-14 md:pt-16 pb-16">
    <p class="font-mono text-xs uppercase tracking-[0.2em] text-primary mb-5">{{ 'home.badge'|trans }}</p>
    <h1 class="font-display text-5xl md:text-6xl font-semibold leading-[1.1] tracking-tight mb-6">
        Aysar Alatrash
    </h1>
    <p class="text-xl text-muted max-w-2xl leading-relaxed mb-10">
        {{ 'home.intro'|trans }}
    </p>
    <div class="flex flex-wrap gap-4">
        <a href="{{ path('app_projekte') }}"
           class="px-6 py-3 bg-primary text-on-primary rounded-md font-medium hover:bg-primary-700 transition-colors">
            {{ 'home.cta_projects'|trans }}
        </a>
        <a href="{{ path('app_kontakt') }}"
           class="px-6 py-3 border border-line rounded-md font-medium text-ink hover:border-primary hover:text-primary transition-colors">
            {{ 'home.cta_contact'|trans }}
        </a>
    </div>
</section>

{# ===== Tech-Stack Streifen ===== #}
<section class="border-y border-line bg-surface/60">
    <div class="max-w-4xl mx-auto px-6 py-8">
        <p class="font-mono text-xs uppercase tracking-[0.2em] text-muted mb-4">{{ 'home.tech_label'|trans }}</p>
        <div class="flex flex-wrap gap-3 text-sm">
            {% for tech in ['PHP 8', 'Symfony', 'Twig', 'Tailwind CSS', 'Doctrine', 'MySQL / MS-SQL', 'JavaScript', 'Linux / Nginx', 'Git'] %}
                <span class="px-4 py-2 bg-surface border border-line rounded-full text-ink/80">{{ tech }}</span>
            {% endfor %}
        </div>
    </div>
</section>

{# ===== Mitgebrachtes Projekt ===== #}
<section class="max-w-4xl mx-auto px-6 py-20">
    <p class="font-mono text-xs uppercase tracking-[0.2em] text-primary mb-5">{{ 'home.featured_label'|trans }}</p>
    <a href="{{ path('app_projekt_intranet') }}"
       class="block p-8 bg-surface border border-line rounded-md hover:border-primary hover:shadow-[0_1px_24px_-12px_rgba(17,24,39,0.25)] transition-all group">
        <div class="flex items-center justify-between gap-4 mb-3">
            <h2 class="font-display text-2xl md:text-3xl font-semibold tracking-tight">
                {{ 'home.featured_title'|trans }}
            </h2>
            <span aria-hidden="true" class="text-primary translate-x-0 group-hover:translate-x-1 transition-transform">&rarr;</span>
        </div>
        <p class="text-muted leading-relaxed">
            {{ 'home.featured_text'|trans }}
        </p>
    </a>
</section>

{# ===== Call to Action ===== #}
<section class="max-w-4xl mx-auto px-6 pb-24">
    <div class="bg-panel rounded-md px-8 py-14 text-center">
        <h2 class="font-display text-3xl md:text-4xl font-semibold tracking-tight text-white mb-4">
            {{ 'home.cta_title'|trans }}
        </h2>
        <p class="text-white/70 mb-8 max-w-xl mx-auto leading-relaxed">
            {{ 'home.cta_text'|trans }}
        </p>
        <a href="{{ path('app_kontakt') }}"
           class="inline-block px-6 py-3 bg-white text-panel rounded-md font-medium hover:bg-white/90 transition-colors">
            {{ 'home.cta_button'|trans }}
        </a>
    </div>
</section>

{% endblock %}
