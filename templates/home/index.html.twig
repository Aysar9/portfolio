{% extends 'base.html.twig' %}
{% block title %}{{ 'home.title'|trans }}{% endblock %}
{% block body %}
<section class="notebook-hero" aria-labelledby="home-heading">
    <div>
        <p class="notebook-eyebrow" data-notebook-motion-target="intro">{{ 'home.notebook_label'|trans }}</p>
        <p class="notebook-role-label" data-notebook-motion-target="intro">{{ 'home.badge'|trans }} <span aria-hidden="true">/</span> PHP &amp; Symfony</p>
        <h1 id="home-heading" class="notebook-hello font-display" aria-label="{{ 'home.greeting'|trans }} Aysar Alatrash."><span aria-hidden="true" data-notebook-motion-target="writing">{{ 'home.greeting'|trans }}</span><br><span aria-hidden="true" class="notebook-highlight" data-notebook-motion-target="writing">Aysar Alatrash.</span></h1>
        <p class="notebook-intro" data-notebook-motion-target="intro">{{ 'home.notebook_intro'|trans }}</p>
        <p class="notebook-detail" data-notebook-motion-target="intro">{{ 'home.notebook_detail'|trans }}</p>
        <div class="notebook-actions" data-notebook-motion-target="intro">
            <a href="{{ path('app_projekte') }}" class="notebook-button">{{ 'home.cta_projects'|trans }} <span aria-hidden="true">↓</span></a>
            <a href="{{ path('app_kontakt') }}" class="notebook-link">{{ 'home.cta_contact'|trans }} <span aria-hidden="true">↗</span></a>
        </div>
    </div>
    <aside class="notebook-profile" aria-label="{{ 'home.profile_label'|trans }}">
        <figure class="notebook-portrait" data-notebook-motion-target="portrait">
            <img src="{{ asset('images/aysar-portrait.png') }}"
                 alt="{{ 'home.portrait_alt'|trans }}"
                 width="1122" height="1402" decoding="async">
            <figcaption>Aysar Alatrash</figcaption>
        </figure>
        <div class="notebook-profile-caption" data-notebook-motion-target="intro">
            <p class="notebook-profile-role">{{ 'home.badge'|trans }}</p>
            <p class="notebook-profile-stack">PHP / Symfony</p>
            <p class="notebook-profile-location">{{ 'layout.location'|trans }}</p>
        </div>
    </aside>
</section>
<section class="notebook-section" data-notebook-motion-target="section" aria-labelledby="projects-heading">
    <div class="notebook-section-title"><span class="notebook-number" aria-hidden="true">01 /</span><h2 id="projects-heading" class="font-display">{{ 'home.work_heading'|trans }}</h2></div>
    <article class="notebook-featured">
        <div>
            <h3 class="font-display">{{ 'home.featured_title'|trans }}</h3>
            <p>{{ 'home.featured_text'|trans }}</p>
            <p class="notebook-tech-caption">Symfony 7.4 · Doctrine DBAL · LDAP · Symfony Messenger</p>
            <a href="{{ path('app_projekt_intranet') }}" class="notebook-link">{{ 'home.case_study'|trans }} <span aria-hidden="true">↗</span></a>
        </div>
        <div class="notebook-stamp">{{ 'home.stamp_title'|trans }}<small>{{ 'home.stamp_text'|trans }}</small></div>
    </article>
    <article class="notebook-other-project">
        <div><h3 class="font-display">{{ 'projekte.jobtrack_title'|trans }}</h3><p>{{ 'home.jobtrack_note'|trans }}</p></div>
        <a href="{{ path('app_projekt_jobtrack') }}" class="notebook-link">{{ 'home.view_project'|trans }} <span aria-hidden="true">↗</span></a>
    </article>
</section>
<section class="notebook-section" data-notebook-motion-target="section" aria-labelledby="tools-heading">
    <div class="notebook-section-title"><span class="notebook-number" aria-hidden="true">02 /</span><h2 id="tools-heading" class="font-display">{{ 'home.tools_heading'|trans }}</h2></div>
    <ul class="notebook-tools">
        {% for tech in ['PHP 8', 'Symfony', 'Doctrine', 'Twig', 'MySQL / MS-SQL', 'JavaScript', 'jQuery', 'Tailwind CSS', 'Linux / Nginx', 'Git', 'Docker / Docker Compose'] %}
            <li>{{ tech }}</li>
        {% endfor %}
    </ul>
    <p class="notebook-pencil-note">{{ 'home.tools_note'|trans }}</p>
</section>
<section class="notebook-section notebook-contact" data-notebook-motion-target="section" aria-labelledby="contact-heading">
    <div class="notebook-section-title"><span class="notebook-number" aria-hidden="true">03 /</span><h2 id="contact-heading" class="font-display">{{ 'home.next_chapter'|trans }}</h2></div>
    <p>{{ 'home.cta_text'|trans }}</p>
    <div class="notebook-actions"><a href="{{ path('app_kontakt') }}" class="notebook-button">{{ 'home.cta_button'|trans }} <span aria-hidden="true">↗</span></a><a href="https://github.com/Aysar9" class="notebook-link">GitHub</a></div>
</section>
{% endblock %}
